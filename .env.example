# ═══════════════════════════════════════════════════════════════════════════
# SpeedX environment variables — copy to `.env` and fill in your values.
# ═══════════════════════════════════════════════════════════════════════════

# ── Core ──────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development          # use `production` on deploy
MONGO_URI=mongodb://127.0.0.1:27017/transitpass_tms

# ── WebAuthn / FIDO2 (must match the deployed origin exactly) ────
RP_ID=localhost               # no scheme, e.g. localhost or app.onrender.com
RP_NAME=SpeedX
EXPECTED_ORIGIN=http://localhost:4000
FRONTEND_URL=http://localhost:4000
BASE_URL=http://localhost:4000   # public base URL used in email links

# ── Sessions & tokens ─────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
SESSION_EXPIRES_IN=8h         # access token lifetime
REFRESH_EXPIRES_IN=14d        # refresh token / session lifetime
REMEMBER_EXPIRES_IN=30d       # "remember me" access token lifetime

# ── Development shortcuts ─────────────────────────────────────────
# Enables the demo-account seeding and the one-click dev login panel.
# NEVER set to 1 with NODE_ENV=production.
ALLOW_DEV_LOGIN=1

# ── Email (production: real SMTP; dev falls back to Ethereal) ─────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM="SpeedX <noreply@speedx.com>"

# ── Security headers / CORS ───────────────────────────────────────
# AUTH_COOKIE_NAME=auth_token
