# ── SpeedX Environment Example ─────────────────────────────────────
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.

# Server
PORT=4000
NODE_ENV=development

# MongoDB (local dev: mongodb://127.0.0.1:27017/transitpass_tms
#             production: use MongoDB Atlas connection string)
MONGO_URI=mongodb://127.0.0.1:27017/transitpass_tms

# WebAuthn / FIDO2 — MUST match the origin users will visit.
#   local dev:  RP_ID=localhost, EXPECTED_ORIGIN=http://localhost:4000
#   deployed:   RP_ID=<your-render-host> (e.g. speedx-demo.onrender.com)
#               EXPECTED_ORIGIN=https://<your-render-host>
RP_ID=localhost
RP_NAME=SpeedX
EXPECTED_ORIGIN=http://localhost:4000
FRONTEND_URL=http://localhost:4000

# JWT
JWT_SECRET=change-me-to-a-long-random-string
SESSION_EXPIRES_IN=8h

# Dev-only convenience: set to 1 (and NODE_ENV != production) to enable
# the dev login panel + auto-seeding of demo accounts. Leave unset/0 in
# production.
ALLOW_DEV_LOGIN=1

# Optional SMTP (Gmail etc.) — if unset, emails are logged to console
# and an Ethereal test account is used.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM="SpeedX <noreply@speedx.com>"
# BASE_URL=http://localhost:4000
